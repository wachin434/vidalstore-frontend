    email {$CORREO:fe.ortegah@duocuc.cl}
}

# DOMINIO llega del compose de gw-azure: con un nombre, Caddy saca el certificado de Let's Encrypt solo.
# Sin DOMINIO (compose local) sirve HTTP en el 80.
{$DOMINIO::80} {
    encode gzip

    # La API va al gateway, que corre en la misma máquina en el 8080 (network_mode: host).
    handle /v1/* {
        reverse_proxy {$GATEWAY:127.0.0.1:8080}
    }

    # El Angular compilado está en /srv. Las rutas de Angular (/callback) caen en index.html.
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
